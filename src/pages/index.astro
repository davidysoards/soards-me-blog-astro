---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Masthead from '../components/Masthead.astro';
import CoverStory from '../components/CoverStory.astro';
import IssueGrid from '../components/IssueGrid.astro';
import TopicFilter from '../components/TopicFilter.astro';
import BackIssues from '../components/BackIssues.astro';
import { newestFirst } from '../lib/topics';
const posts = (await getCollection('posts')).sort(newestFirst);
const [cover, ...rest] = posts;
const older = rest.slice(6);
---

<BaseLayout>
	<main id="main" class="mx-auto w-full max-w-7xl px-4.5 md:px-8" data-home>
		<Masthead stories={rest.slice(0, 3)} />
		{cover && <CoverStory post={cover} />}
		<section data-story-section aria-labelledby="issue-heading">
			<div class="mt-9 flex flex-wrap items-baseline justify-between gap-3 border-t-4 border-ink pt-3 pb-5 md:mt-12">
				<h2 id="issue-heading" class="text-4xl leading-none md:text-5xl">
					Also in this issue
				</h2>
				<TopicFilter />
			</div>
			<IssueGrid posts={rest.slice(0, 6)} />
			<p data-empty hidden class="py-5 text-mute italic">
				No stories in this section for this topic. Browse the back issues below.
			</p>
		</section>
		<section data-story-section aria-labelledby="back-heading">
			<div class="mt-9 flex flex-wrap items-baseline justify-between gap-3 border-t-4 border-ink pt-3 pb-5 md:mt-12">
				<h2 id="back-heading" class="text-4xl leading-none md:text-5xl">
					Back issues
				</h2>
				<span class="font-mono text-xs font-medium tracking-wider text-mute uppercase">
					<span class="text-accent-text">////</span> <span data-count>{older.length} stories</span>
				</span>
			</div>
			<BackIssues posts={older} />
			<p data-empty hidden class="py-5 text-mute italic">
				No back issues for this topic.
			</p>
		</section>
		<p class="sr-only" role="status" data-filter-status></p>
	</main>
</BaseLayout>
