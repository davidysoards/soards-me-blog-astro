---
import { getCollection } from 'astro:content';
import { topics, postTopics, newestFirst } from '../../lib/topics';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BackIssues from '../../components/BackIssues.astro';
import TopicFilter from '../../components/TopicFilter.astro';
export async function getStaticPaths() {
	const posts = (await getCollection('posts')).sort(newestFirst);
	return topics.map((topic) => ({
		params: { topic: topic.id },
		props: { topic, posts: posts.filter((post) => postTopics(post).includes(topic)) },
	}));
}
const { topic, posts } = Astro.props;
---

<BaseLayout pageTitle={topic.label}>
	<main id="main" class="mx-auto w-full max-w-7xl px-4.5 md:px-8 pt-6 pb-12">
		<div class="mt-9 flex flex-wrap items-baseline justify-between gap-3 border-t-4 border-ink pt-3 pb-5 md:mt-12">
			<h1 class="text-4xl leading-none md:text-5xl">{topic.label} stories</h1>
			<TopicFilter active={topic.id} />
		</div>
		<BackIssues posts={posts} />
	</main>
</BaseLayout>
