---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BackIssues from '../../components/BackIssues.astro';
import { newestFirst } from '../../lib/topics';
import { getCollection } from 'astro:content';
export async function getStaticPaths() {
	const posts = (await getCollection('posts')).sort(newestFirst);
	return [...new Set(posts.flatMap((post) => post.data.tags || []))].map((tag) => ({
		params: { tag },
		props: { posts: posts.filter((post) => post.data.tags?.includes(tag)) },
	}));
}
const { tag } = Astro.params;
const { posts } = Astro.props;
---

<BaseLayout pageTitle={`Posts tagged ${tag}`}>
	<main id="main" class="mx-auto w-full max-w-7xl px-4.5 md:px-8 pt-6 pb-12">
		<div class="mt-9 flex flex-wrap items-baseline justify-between gap-3 border-t-4 border-ink pt-3 pb-5 md:mt-12">
			<h1 class="text-4xl leading-none md:text-5xl">Filed under: #{tag}</h1>
			<span class="font-mono text-xs font-medium tracking-wider uppercase text-mute">
				<span class="text-accent-text">////</span> {posts.length}{' '}
				{posts.length === 1 ? 'story' : 'stories'}
			</span>
		</div>
		<BackIssues posts={posts} />
		<a
			class="font-mono text-xs font-medium tracking-wider uppercase text-mute hover:text-accent-text"
			href="/"
		>
			All stories
		</a>
	</main>
</BaseLayout>
