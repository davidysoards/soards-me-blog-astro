---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout pageTitle="Not found">
	<main id="main" class="mx-auto w-full max-w-7xl px-4.5 md:px-8 py-20">
		<p class="font-mono text-xs tracking-wider uppercase text-mute">
			<b class="font-normal text-accent-text">////</b> Off the record
		</p>
		<h1 class="my-5 text-post-title leading-[1.1]">404. lost track.</h1>
		<p class="mb-6">This page isn’t in the collection.</p>
		<a
			href="/"
			class="font-mono text-xs tracking-wider uppercase text-accent-text underline decoration-current/50 hover:decoration-current"
		>
			Back to the latest issue
		</a>
	</main>
</BaseLayout>
