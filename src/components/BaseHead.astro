---
import '../styles/tailwind.css';
import { Font } from 'astro:assets';
import { SITE_NAME } from '../consts';

interface Props {
	title: string;
	description: string;
	image?: string;
	pubDate?: Date;
	updatedDate?: Date;
	articleTitle?: string;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const {
	title,
	description,
	image = '/img/og-default.png',
	pubDate,
	updatedDate,
	articleTitle,
} = Astro.props;
const publishedTime = pubDate?.toISOString();
const modifiedTime = updatedDate?.toISOString();
const imageURL = new URL(image, Astro.site);
const siteURL = new URL('/', Astro.site);
const personID = new URL('#person', siteURL).href;
const websiteID = new URL('#website', siteURL).href;
const structuredData = {
	'@context': 'https://schema.org',
	'@graph': [
		{
			'@type': 'Person',
			'@id': personID,
			name: SITE_NAME,
			url: siteURL.href,
			jobTitle: 'User Experience Engineer',
			sameAs: [
				'https://github.com/davidysoards',
				'https://www.linkedin.com/in/davidysoards/',
				'https://x.com/ninjasoards',
				'https://design.soards.me/',
			],
		},
		{
			'@type': 'WebSite',
			'@id': websiteID,
			url: siteURL.href,
			name: SITE_NAME,
			alternateName: 'blog.soards.me',
			author: { '@id': personID },
			inLanguage: 'en',
		},
		...(pubDate
			? [
					{
						'@type': 'BlogPosting',
						'@id': new URL('#article', canonicalURL).href,
						url: canonicalURL.href,
						mainEntityOfPage: canonicalURL.href,
						headline: articleTitle ?? title,
						description,
						image: imageURL.href,
						datePublished: publishedTime,
						...(updatedDate ? { dateModified: modifiedTime } : {}),
						author: { '@id': personID },
						isPartOf: { '@id': websiteID },
						inLanguage: 'en',
					},
				]
			: []),
	],
};
const isPost = Astro.url.pathname.startsWith('/posts/');
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="icon" href="/favicon.ico" />
<meta name="generator" content={Astro.generator} />

<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<Font cssVariable="--font-anton" preload />
<Font cssVariable="--font-literata" preload={isPost ? true : [{ style: 'normal' }]} />
<link rel="alternate" type="application/rss+xml" title={SITE_NAME} href="/rss.xml" />

<link rel="sitemap" href="/sitemap-index.xml" />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="author" content={SITE_NAME} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={pubDate ? 'article' : 'website'} />
<meta property="og:site_name" content={SITE_NAME} />
{pubDate && <meta property="article:published_time" content={publishedTime} />}
{updatedDate && <meta property="article:modified_time" content={modifiedTime} />}
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={imageURL} />

<meta name="twitter:card" content="summary_large_image" />

<!-- Escape HTML delimiters so content cannot close the JSON-LD script element. -->
<script
	is:inline
	type="application/ld+json"
	set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')}
/>
