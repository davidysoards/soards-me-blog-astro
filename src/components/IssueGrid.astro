---
import { postTopics, postUrl, type Post } from '../lib/topics';
import Duotone from './Duotone.astro';
import FormattedDate from './FormattedDate.astro';

interface Props {
	posts: Post[];
}
const { posts } = Astro.props;
---

<div class="grid grid-cols-1 gap-x-7 gap-y-8 md:grid-cols-3">
	{posts.map((post) => {
		const matchingTopics = postTopics(post);
		return (
			<a
				class="group"
				href={postUrl(post)}
				data-topics={matchingTopics.map((topic) => topic.id).join(',')}
			>
				{post.data.heroImage && <Duotone class="mb-3 aspect-3/2" image={post.data.heroImage} />}
				<div class="font-mono text-xs font-medium tracking-wider uppercase text-mute">
					<span class="text-accent-text">////</span> <FormattedDate date={post.data.pubDate} /> /{' '}
					{matchingTopics[0]?.label}
				</div>
				<h3 class="mt-1.5 mb-2 text-3xl group-hover:text-accent-text">{post.data.title}</h3>
				<p class="text-base leading-normal text-mute">{post.data.description}</p>
			</a>
		);
	})}
</div>
