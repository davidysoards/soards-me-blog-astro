---
import { topics } from '../lib/topics';
const { active = 'all' } = Astro.props;
---

<nav class="flex flex-wrap gap-1" aria-label="Filter stories by topic">
	{[{ id: 'all', label: 'All' }, ...topics].map((topic) => (
		<a
			class="inline-block border border-ink px-2.5 py-1.5 font-mono text-xs uppercase hover:bg-ink hover:text-paper aria-current:font-bold aria-current:border-accent aria-current:bg-accent aria-current:text-white dark:aria-current:text-black"
			href={topic.id === 'all' ? '/' : `/topics/${topic.id}/`}
			data-topic={topic.id}
			aria-current={active === topic.id ? 'true' : undefined}
		>
			{topic.label}
		</a>
	))}
</nav>
<script>
	const home = document.querySelector('[data-home]');
	if (home) {
		const links = home.querySelectorAll<HTMLAnchorElement>('[data-topic]');
		const status = home.querySelector('[data-filter-status]')!;
		const sections = [...home.querySelectorAll<HTMLElement>('[data-story-section]')].map(
			(section) => ({
				stories: [...section.querySelectorAll<HTMLElement>('[data-topics]')].map((element) => ({
					element,
					topics: element.dataset.topics?.split(','),
				})),
				empty: section.querySelector<HTMLElement>('[data-empty]')!,
				counter: section.querySelector('[data-count]'),
			}),
		);

		links.forEach((link) =>
			link.addEventListener('click', (event) => {
				if (event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
				event.preventDefault();
				const topic = link.dataset.topic!;
				for (const section of sections) {
					let count = 0;
					for (const story of section.stories) {
						story.element.hidden = topic !== 'all' && !story.topics?.includes(topic);
						if (!story.element.hidden) count++;
					}
					section.empty.hidden = count > 0;
					if (section.counter)
						section.counter.textContent = `${count} ${count === 1 ? 'story' : 'stories'}`;
				}
				links.forEach((item) => item.setAttribute('aria-current', String(item === link)));
				status.textContent = `Showing ${link.textContent} stories`;
			}),
		);
	}
</script>
