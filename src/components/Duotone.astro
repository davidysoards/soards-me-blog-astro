---
interface Props {
	image: string;
	eager?: boolean;
	class?: string;
}
const { image, eager = false, class: className } = Astro.props;
---

<div class:list={['duo', className]}>
	<img
		src={`/img/${image}`}
		alt=""
		width="1200"
		height="800"
		loading={eager ? 'eager' : 'lazy'}
		fetchpriority={eager ? 'high' : 'auto'}
	/>
</div>
