---
import { SOCIAL_LINKS } from '../consts';
---

<footer class="mx-auto mt-6 w-full max-w-7xl px-4.5 md:px-8">
	<div class="flex items-center justify-between gap-2 pt-3.5 pb-8 font-mono text-xs font-medium text-mute uppercase sm:tracking-wider md:pb-10">
		<span class="shrink-0 whitespace-nowrap">© {new Date().getFullYear()} David Soards</span>
		<nav class="flex shrink-0 items-center gap-1 sm:gap-2" aria-label="Footer navigation">
			{SOCIAL_LINKS.map(({ label, href, icon }) => (
				<a
					class="inline-flex size-6 items-center justify-center hover:text-accent-text"
					href={href}
					target="_blank"
					rel="noopener"
				>
					<span class:list={[icon, 'size-4']} aria-hidden="true"></span>
					<span class="sr-only">{label}</span>
				</a>
			))}
			<a
				class="inline-flex size-6 items-center justify-center hover:text-accent-text"
				href="/rss.xml"
			>
				<span class="i-lucide-rss size-4" aria-hidden="true"></span>
				<span class="sr-only">RSS</span>
			</a>
		</nav>
	</div>
</footer>
