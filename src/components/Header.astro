---
import { getCollection } from 'astro:content';
import DYSMark from './DYSMark.astro';
import ThemeToggle from './ThemeToggle.astro';

const posts = await getCollection('posts');
const isHome = Astro.url.pathname === '/';

let first = posts[0];
let latest = posts[0];
for (const post of posts) {
	if (post.data.pubDate < first.data.pubDate) first = post;
	if (post.data.pubDate > latest.data.pubDate) latest = post;
}

const vol = first ? new Date().getFullYear() - first.data.pubDate.getUTCFullYear() + 1 : 1;
const issue = posts.length;
const month = latest
	? latest.data.pubDate.toLocaleDateString('en-US', {
			month: 'short',
			year: 'numeric',
			timeZone: 'UTC',
		})
	: '';

const link = 'hover:text-accent';
---

<header>
	<div class="mono flex items-center justify-between py-2.5">
		{
			isHome ? (
				<span>
					<b>////</b> Vol. {vol}
					<span class="max-[860px]:hidden">
						{' '}
						— Issue {issue} — {month}
					</span>
				</span>
			) : (
				<a href="/" class:list={['nameplate flex items-center gap-2.5 text-brand text-accent', link]}>
					<DYSMark class="size-[26px]" />
					SOARDS
				</a>
			)
		}
		<nav class="flex items-center gap-[18px]">
			<a href="/" class={link}>Writing</a>
			<a href="https://design.soards.me/" target="_blank" rel="noopener" class:list={[link, 'max-[860px]:hidden']}>
				Case studies
			</a>
			<span class="max-[860px]:hidden">
				<a href="https://github.com/davidysoards" target="_blank" rel="noopener" class={link}>GitHub</a>
				{' / '}
				<a href="https://x.com/ninjasoards" target="_blank" rel="noopener" class={link}>X</a>
				{' / '}
				<a href="https://www.linkedin.com/in/davidysoards/" target="_blank" rel="noopener" class={link}>
					LinkedIn
				</a>
				{' / '}
				<a href="/rss.xml" class={link}>RSS</a>
			</span>
			<ThemeToggle />
		</nav>
	</div>
	{!isHome && <div class="rule-major"></div>}
</header>
