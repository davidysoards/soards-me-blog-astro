---
import DYSLogo from './DYSLogo.astro';
import { postTopics, postUrl, readingMinutes, type Post } from '../lib/topics';
interface Props {
	stories: Post[];
}
const { stories } = Astro.props;
---

<header class="pt-3 md:pt-5">
	<div class="flex items-stretch justify-between gap-6 lg:gap-10">
		<div class="flex w-full items-end gap-[.1em] text-masthead max-md:justify-between">
			<h1 class="text-[1em] leading-[.9] whitespace-nowrap text-accent uppercase">
				<span class="mb-0.5 block font-serif text-[.22em] leading-none font-normal text-ink lowercase italic">
					David
				</span>
				Soards
			</h1>
			<span class="mb-1 block size-[.85em] text-ink dark:text-accent">
				<DYSLogo class="size-full" />
			</span>
		</div>
		<nav
			class="hidden w-60 shrink-0 flex-col pb-1 text-right md:flex lg:w-72 xl:w-80"
			aria-label="Inside this issue"
		>
			<div class="mb-2 font-mono text-xs font-medium tracking-wider text-mute uppercase">
				<span class="text-accent-text">////</span> Inside this issue
			</div>
			<ul class="flex flex-1 flex-col justify-between gap-2">
				{stories.map((post, index) => (
					<li class:list={[index === 2 && 'hidden min-[1152px]:block']}>
						<a class="group block" href={postUrl(post)}>
							<span class="block font-display text-sm leading-[1.14] text-balance text-ink lowercase group-hover:text-accent-text lg:text-lg xl:text-xl">
								{post.data.title}
							</span>
							<span class="mt-0.5 block font-mono text-[11px] leading-none font-medium tracking-wider text-mute uppercase">
								{postTopics(post)[0]?.label} / {readingMinutes(post)} min read
							</span>
						</a>
					</li>
				))}
			</ul>
		</nav>
	</div>
	<div class="mt-4 flex items-center justify-between gap-4 bg-accent px-3 py-1.5 font-mono text-xs font-bold tracking-wider text-white uppercase md:mt-5 dark:text-black">
		<span>//// User Experience Engineer</span>
		<span class="hidden md:inline">Writing on AI, design &amp; the web</span>
	</div>
	<div class="mt-0.75 h-[1.5px] bg-accent" aria-hidden="true"></div>
</header>
