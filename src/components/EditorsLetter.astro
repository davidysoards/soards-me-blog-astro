---
import { EDITORS_LETTER } from '../consts';
---

<section class="mt-8 border-2 border-ink px-5 pt-4.5 pb-5" aria-labelledby="letter-heading">
	<h3
		id="letter-heading"
		class="mb-2.5 font-sans text-xs font-semibold leading-none tracking-[.2em] uppercase text-accent-text"
	>
		Editor's letter
	</h3>
	<p class="first-letter:float-left first-letter:pt-1 first-letter:pr-2 first-letter:font-display first-letter:text-[3.5em] first-letter:leading-[.82] first-letter:text-accent columns-1 gap-6 text-[15px] leading-[1.55] lg:columns-2">
		{EDITORS_LETTER}
	</p>
</section>
