---
import { EDITORS_LETTER } from '../consts';
---
<section class="relative mt-6.5 border border-frame px-4.5 pt-6.5 pb-5 md:px-7 md:pt-7.5 md:pb-6" aria-labelledby="letter-heading"><h2 id="letter-heading" class="absolute top-0 left-3 m-0 -translate-y-1/2 bg-paper px-2 font-sans text-xs font-semibold leading-none tracking-[.2em] uppercase text-accent-text md:left-5 md:px-2.5">Editor's letter<small class="ml-3 inline font-mono text-xs tracking-wider uppercase text-mute leading-[1.4] font-normal">//// From David</small></h2><p class="first-letter:float-left first-letter:pt-1 first-letter:pr-2 first-letter:font-display first-letter:text-[3.5em] first-letter:leading-[.82] first-letter:text-accent m-0 columns-1 gap-8 text-base leading-[1.55] md:columns-2">{EDITORS_LETTER}</p></section>
