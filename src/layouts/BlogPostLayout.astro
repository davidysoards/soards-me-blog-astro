---
import type { Post } from '../lib/topics';
import FormattedDate from '../components/FormattedDate.astro';
import BaseLayout from './BaseLayout.astro';
import Duotone from '../components/Duotone.astro';
import Headline from '../components/Headline.astro';
import DYSMark from '../components/DYSMark.astro';
import PrevNext from '../components/PrevNext.astro';
type Props = Post['data'] & { previous?: Post; next?: Post };
const { title, subtitle, description, pubDate, updatedDate, heroImage, tags, previous, next } =
	Astro.props;
---

<BaseLayout
	description={description}
	pageTitle={title}
	pubDate={pubDate}
	updatedDate={updatedDate}
	image={heroImage ? `/img/${heroImage}` : undefined}
>
	<main id="main" class="mx-auto w-full max-w-7xl px-4.5 md:px-8">
		<article>
			<header
				class:list={[
					'grid gap-5 pt-6 pb-8 md:gap-10 md:pt-10',
					heroImage ? 'md:grid-cols-[1.05fr_1fr]' : 'max-w-225',
				]}
			>
				<div class="@container flex flex-col">
					<div class="font-mono text-xs font-medium tracking-wider text-mute uppercase">
						<span class="text-accent-text">////</span> Feature{' '}
						{tags?.[0] && <> &nbsp;/&nbsp; {tags[0]}</>}
					</div>
					<h1
						class:list={[
							'mt-3 mb-4.5 text-post-title text-balance md:mt-auto md:pt-6',
							heroImage && 'md:text-[length:clamp(40px,84cqi/sqrt(var(--len)),96px)]',
						]}
						style={`--len: ${title.length}`}
					>
						<Headline title={title} />
					</h1>
					<p class="mb-4.5 max-w-[32em] text-lg leading-[1.45] text-mute italic md:text-2xl">
						{subtitle ?? description}
					</p>
					<div class="font-mono text-xs font-medium tracking-wider text-mute uppercase">
						By David Soards &nbsp;/&nbsp; <FormattedDate date={pubDate} />
						{tags?.map((tag) => (
							<>
								{' '}
								&nbsp;
								<a class="hover:text-accent-text" href={`/tags/${tag}/`}>
									<span class="text-accent-text">#</span>
									{tag}
								</a>
							</>
						))}
					</div>
					{updatedDate && (
						<div class="mt-2 font-mono text-xs font-medium tracking-wider text-mute uppercase">
							Updated <FormattedDate date={updatedDate} />
						</div>
					)}
				</div>
				{heroImage && (
					<Duotone class="order-2 aspect-4/3 md:order-none md:self-end" image={heroImage} eager />
				)}
			</header>
			<div class="prose-c mx-auto max-w-[65ch] pt-8 pb-6 text-lg leading-relaxed break-words text-mute md:pt-12 md:text-xl">
				<slot />
			</div>
			<div class="mt-2 mb-6 text-center text-mute" aria-hidden="true">
				<DYSMark class="size-8 align-middle md:size-10" />
			</div>
		</article>
		<PrevNext previous={previous} next={next} />
	</main>
</BaseLayout>
